        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Registration needs a retry",
        "completionMessage": "Registration or download confirmation could not complete. Return through the same marketing download choice to retry the same attempt. A failed/ambiguous Sheet write does not authorize a download and retries reuse the reserved row.",
        "options": {}
      }
    },
    {
      "id": "setup-required",
      "name": "Setup required",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -340
      ],
      "parameters": {
        "content": "## INACTIVE \u2014 do not publish until configured\nSee README.md. Configure approved notice/API origin and select server Header Auth + scoped Google Sheets OAuth credentials. Dedicated protected A:M tab; no inserts/sorts/deletes. Stable UUIDv4 comes from marketing production form query, never execution ID. Fixed RAW update, never append. P12 download grant is a separate unconnected step.",
        "width": 800,
        "height": 240
      }
    }
