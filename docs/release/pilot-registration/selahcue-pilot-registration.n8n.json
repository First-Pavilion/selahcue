      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate registration').first().json.api_origin + '/v1/pilot/registrations:confirm' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({registration_id:$('Reserve registration').first().json.registration_id,sheet_ack:{spreadsheetId:$json.spreadsheetId,updatedRange:$json.updatedRange,updatedRows:$json.updatedRows,updatedColumns:$json.updatedColumns,updatedCells:$json.updatedCells}}) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": false
    },
    {
      "id": "validate-saved-receipt",
      "name": "Validate saved receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        -100
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst original = $('Validate registration').first().json.payload;\nconst now = Date.now() / 1000;\nif (result.schema_version !== 1 || result.state !== 'confirmed' || result.registration_id !== original.registration_id ||\n    typeof result.receipt !== 'string' || !result.receipt.length || result.receipt.length > 2048 ||\n    !Number.isSafeInteger(result.expires_at) || result.expires_at <= now || result.expires_at > now + 3600)\n  throw new Error('Registration was not confirmed. No download is authorized.');\nreturn [{json:result}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "registration-saved",
      "name": "Registration saved",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [
        2000,
        -100
      ],
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Registration saved",
        "completionMessage": "Your pilot registration has been recorded. Download delivery is not connected in this inactive handoff; complete the separate private download-grant integration before publishing.",
        "options": {}
      }
    },
    {
      "id": "correct-registration",
      "name": "Correct registration",
