                    "type": "string",
                    "enum": [
                      "English",
                      "Yoruba",
                      "Igbo",
                      "Hausa"
                    ]
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "reference_words": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "substitutions": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "deletions": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "insertions": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "silence_hallucination_words": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "omission_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "error_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "peak_process_tree_memory_bytes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "dropped_audio_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "word_error_rate": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "latency_ms": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "switch_recovery_ms": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "retrieval_recall_at_5": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "retrieval_mrr": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "false_passage_suggestions": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "retrieval_query_source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "asr",
                    "clean",
                    null
                  ]
                },
                "missing_metrics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "corpus_id",
                "split",
                "languages",
                "reference_words",
                "substitutions",
                "deletions",
                "insertions",
                "silence_hallucination_words",
                "omission_count",
                "error_count",
                "peak_process_tree_memory_bytes",
                "dropped_audio_count",
                "word_error_rate",
                "latency_ms",
                "switch_recovery_ms",
                "retrieval_recall_at_5",
                "retrieval_mrr",
                "false_passage_suggestions",
                "retrieval_query_source",
                "missing_metrics"
              ],
              "additionalProperties": false
            }
          },
          "per_language": {
            "type": "object",
            "properties": {
              "English": {
                "$ref": "#/$defs/summary"
              },
              "Yoruba": {
                "$ref": "#/$defs/summary"
              },
              "Igbo": {
                "$ref": "#/$defs/summary"
              },
              "Hausa": {
                "$ref": "#/$defs/summary"
              }
            },
            "required": [
              "English",
              "Yoruba",
              "Igbo",
              "Hausa"
            ],
            "additionalProperties": false
          },
          "mixed_language": {
            "type": "object",
            "properties": {
              "scored_samples": {
                "type": "integer",
                "minimum": 0
              },
              "reference_words": {
                "type": "integer",
                "minimum": 0
              },
              "word_error_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "scored_samples",
              "reference_words",
              "word_error_rate"
            ],
            "additionalProperties": false
          },
          "aggregate": {
            "$ref": "#/$defs/summary"
          },
          "per_split": {
            "type": "object",
            "properties": {
              "tuning": {
                "$ref": "#/$defs/summary"
              },
              "held_out": {
                "$ref": "#/$defs/summary"
              }
            },
            "required": [
              "tuning",
              "held_out"
            ],
            "additionalProperties": false
          }
