  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "Redacted profile observations and explicit decision; no acceptance thresholds implied",
  "description": "accepted/infeasible are reserved for separately reviewed decisions. The evaluator emits insufficient and no selected profile because owner thresholds and device acceptance are outside this tooling.",
  "$defs": {
    "summary": {
      "type": "object",
      "properties": {
        "represented_samples": {
          "type": "integer",
          "minimum": 0
        },
        "scored_monolingual_samples": {
          "type": "integer",
          "minimum": 0
        },
        "mixed_language_samples": {
          "type": "integer",
          "minimum": 0
        },
        "reference_words": {
          "type": "integer",
          "minimum": 0
        },
        "substitutions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        },
        "insertions": {
          "type": "integer",
          "minimum": 0
        },
        "silence_hallucination_words": {
          "type": "integer",
          "minimum": 0
        },
        "retrieval_evaluated_samples": {
          "type": "integer",
          "minimum": 0
        },
        "false_passage_suggestions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "word_error_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "retrieval_recall_at_5": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "retrieval_mrr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "represented_samples",
        "scored_monolingual_samples",
        "mixed_language_samples",
        "reference_words",
        "substitutions",
        "deletions",
        "insertions",
        "silence_hallucination_words",
        "retrieval_evaluated_samples",
        "false_passage_suggestions",
        "word_error_rate",
        "retrieval_recall_at_5",
        "retrieval_mrr"
      ],
      "additionalProperties": false
    }
  }
}
