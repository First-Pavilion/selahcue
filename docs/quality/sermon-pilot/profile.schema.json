{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "outcome": {
      "enum": [
        "accepted",
        "insufficient",
        "infeasible"
      ]
    },
    "selected_profile": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "engine_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "English",
              "Yoruba",
              "Igbo",
              "Hausa"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "rights_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration": {
          "type": "object"
        },
        "role": {
          "enum": [
            "production_baseline",
            "experimental"
          ]
        }
      },
      "required": [
        "id",
        "engine_sha256",
        "model_sha256",
        "config_sha256",
        "languages",
        "rights_source",
        "configuration",
        "role"
      ],
      "additionalProperties": false,
      "description": "Only a separately reviewed acceptance record can populate a selected production profile. Configuration records measured settings and exact asset identities."
    },
    "evidence_kind": {
      "enum": [
        "synthetic",
        "authorized_real",
        "unavailable"
      ]
    },
    "normalization": {
      "type": "string"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "required_languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "held_out_missing_languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_scenarios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "required_languages",
        "missing_languages",
        "held_out_missing_languages",
        "missing_scenarios",
        "sample_count"
      ],
      "additionalProperties": false
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "per_profile": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile_id": {
            "type": "string"
          },
          "engine_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "model_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "config_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "English",
                "Yoruba",
                "Igbo",
                "Hausa"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "role": {
            "enum": [
              "production_baseline",
              "experimental"
            ]
          },
          "rights_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed_runs": {
            "type": "integer",
            "minimum": 0
          },
          "complete": {
            "type": "boolean"
          },
          "missing_run_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "corpus_id": {
                  "type": "string"
                },
                "split": {
                  "type": "string"
                },
                "languages": {
                  "type": "array",
