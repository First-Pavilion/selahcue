{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "expected_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "engine_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          },
          "model_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          },
          "config_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "English",
                "Yoruba",
                "Igbo",
                "Hausa"
              ]
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 4
          },
          "rights_source": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "configuration": {
            "type": "object"
          },
          "role": {
            "enum": [
              "production_baseline",
              "experimental"
            ]
          }
        },
        "required": [
          "id",
          "engine_sha256",
          "model_sha256",
          "config_sha256",
          "languages",
          "rights_source",
          "configuration",
          "role"
        ],
        "additionalProperties": false
      },
      "maxItems": 4
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "audio_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          },
          "speaker_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "English",
                "Yoruba",
                "Igbo",
                "Hausa"
              ]
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 4
          },
          "split": {
            "enum": [
              "tuning",
              "held_out"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1
          },
          "reference_text": {
            "type": "string",
            "maxLength": 4096
          },
          "expected_references": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "uniqueItems": true,
            "maxItems": 32
          },
          "authorized_use": {
            "const": true
          },
          "scenario": {
            "enum": [
              "ordinary_speech",
              "silence",
              "ambiguous_scripture",
              "language_switch",
              "interpreter_alternation"
            ]
          }
        },
        "required": [
          "id",
          "audio_sha256",
          "speaker_id",
          "languages",
          "split",
          "duration_ms",
          "reference_text",
          "expected_references",
          "authorized_use",
          "scenario"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "evidence_kind": {
      "enum": [
        "synthetic",
        "authorized_real",
        "unavailable"
      ]
    }
  },
  "required": [
    "schema_version",
    "expected_profiles",
    "samples",
    "evidence_kind"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus.schema.json",
  "title": "Private authorized pilot corpus; never commit speech/transcripts",
  "description": "Private bounded tooling batch: <=128 samples, <=4 profiles, <=256 matrix entries; 4096 characters/text. Evaluator also enforces file/tree/segment/token/aggregate alignment-work guards documented in README. These are workload guards, not quality thresholds."
}
