# ---------------------------------------------------------------------------
# Sample dev .env for the SelahCue Platform API — copy to api/.env and fill in.
# Key names follow the First Pavilion house convention (see yharah-logistics
# api/.env.sample). Production / staging values live in the Coolify dashboard,
# never here.
# ---------------------------------------------------------------------------

# --- Django core ---
ENVIRONMENT=dev
DEBUG=1
# Required whenever ENVIRONMENT is not "dev". Outside dev the app refuses to boot if it is blank,
# the public dev key (selahcue-dev-only-insecure-key) or the old example value
# (replace-me-with-a-fresh-key). Letter case, whitespace, matched ASCII quotes and invisible
# format characters (a BOM, zero-width space or joiner, soft hyphen) do not hide them.
# Blank is deliberate: in dev a blank key falls back to the dev key;
# anywhere else a copy of this file refuses to start until you set a real one.
# With ENVIRONMENT genuinely unset, a blank key plus any non-local allowed host refuses startup.
# Explicit dev and local-only defaults remain supported; deployments must set staging/prod and a real key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# SPACE-separated (house convention). Commas are tolerated.
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 testserver [::1]
DEFAULT_EMAIL=info@firstpavitech.com
DEFAULT_FROM_EMAIL=noreply@selahcue.com

# --- Database (matches the db service in docker-compose.yml) ---
# Defaults to bundled SQLite when SQL_ENGINE is unset, so a bare `pytest` needs no env.
# Use postgresql in any real deployment: the DEC-004 device instance limit relies on
# select_for_update, which SQLite silently no-ops.
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=selahcue_db
SQL_USER=pavilion
SQL_PASSWORD=pavilion
SQL_HOST=db
SQL_PORT=5432

# --- Mail (mailhog catches everything locally on 1025) ---
MAIL_HOST=selahcue_mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Base URL the verification and password-reset emails link to. NOTE: /verify and /reset do
# not exist yet — they land with slice 4 (86ajy7anx), so those links 404 until then.
FRONTEND_BASE_URL=http://localhost:2000

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Cache ---
# Redis db 1, NOT db 2 (the Celery broker above) — a FLUSHDB on either must not take the
# other with it. Unset falls back to a per-process LocMemCache, which is why a bare
# `pytest` needs no Redis; that fallback is not usable across web workers in production.
CACHE_URL=redis://redis:6379/1
# Seconds the cache waits on Redis before giving up, so a Redis that accepts connections but never
# answers degrades the throttle (fails open) instead of blocking every request. Allowed range
# 0.05 to 10 (anything else, including 0, refuses to boot). Defaults to 0.5 each when unset or
# blank; see docs/ops/DEPLOYMENT.md §6b.
# CACHE_SOCKET_CONNECT_TIMEOUT=0.5
# CACHE_SOCKET_TIMEOUT=0.5
# Per-worker cache circuit: consecutive errors before bypass (integer 1..100),
# then seconds before exactly one recovery probe (finite 0.1..60). Blank uses default.
# CACHE_CIRCUIT_FAILURE_THRESHOLD=3
# CACHE_CIRCUIT_COOLDOWN=5
# Number of proxies in front of Django. Leave 0 until the ingress is known: above 0 the
# API reads X-Forwarded-For, and a caller-supplied header is a rate-limiter bypass.
SELAHCUE_TRUSTED_PROXY_COUNT=0
# Behind a TLS-terminating proxy, set to 1 so Django believes `X-Forwarded-Proto: https`: without
# it a browser's `Origin: https://...` is refused by CSRF (403) and HSTS is never sent. On is
# 1/true/yes/on; anything else (including y, enabled, 2) is off. Leave 0 unless EVERY route to
# Django goes through a proxy that overwrites that header, otherwise a client can forge "https".
# Turning it on also makes the one-year includeSubDomains+preload HSTS policy live: read the
# rollout steps first. See docs/ops/DEPLOYMENT.md section 6c.
SELAHCUE_TRUST_FORWARDED_PROTO=0
# Exact public https origins, comma- or whitespace-separated, only if the browser Origin differs
# from the Host the proxy forwards (a rewritten Host, or a non-443 port), e.g.
# https://selahcue.example . No `*`, no path, no default port (:443), no leading-dot host; a bad
# entry refuses to boot.
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- SelahCue licensing ---
# Ed25519 seed signing offline entitlement manifests (DEC-004). NO default: without it
# GET /v1/entitlements/manifest returns 500 rather than serving an unsigned manifest.
# Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
SELAHCUE_ENTITLEMENT_SIGNING_KEY=

# Comma-separated origins for the web client.
SELAHCUE_CORS_ALLOWED_ORIGINS=
# Startup refuses true outside exact dev (including staging); this trusts caller-supplied identities.
SELAHCUE_TRUST_ACTOR_HEADERS=0

# --- Error monitoring (staging/prod only; leave blank locally) ---
SENTRY_DSN=
