# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local dev database (never commit — SQLite dev/test DB)
db.sqlite3
db.sqlite3-journal
*.sqlite3

# Editable-install build metadata (`pip install -e .`, used by the CI job and local dev)
*.egg-info/
build/
dist/

# Virtualenvs
.venv/
venv/
env/

# Local env / secrets (keys are documented in the root deployments.md)
.env
.env.*
