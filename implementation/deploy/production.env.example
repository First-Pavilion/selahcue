# SelahCue production environment for docker-compose.prod.yml on Coolify.
#
# Paste this into the resource's Environment Variables page (Developer view), then fill in every
# empty value. Mark SECRET_KEY, SELAHCUE_ENTITLEMENT_SIGNING_KEY, SQL_PASSWORD, REDIS_PASSWORD and
# MAIL_PASSWORD as secrets/locked. Never commit a filled-in copy. (For a local rehearsal, save a
# copy as deploy/production.env, which is gitignored, and pass it with --env-file.)
#
# The compose file fixes everything else (database/Redis hosts and URLs, proxy trust, DEBUG=0,
# pilot flags off). Full reference: ../deployments.md section 1.
#
# Generate the secrets on a trusted machine, in a terminal that is not logged:
#   SECRET_KEY:                       python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
#   SELAHCUE_ENTITLEMENT_SIGNING_KEY: python3 -c 'import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
#   SQL_PASSWORD, REDIS_PASSWORD:     python3 -c 'import secrets; print(secrets.token_hex(32))'
# (hex for the two passwords: REDIS_PASSWORD is placed inside redis:// URLs unescaped.)
# SECRET_KEY and the entitlement seed must stay stable across deploys and be backed up outside
# Coolify: changing them invalidates every token fingerprint and offline manifest.

# Public hostnames (no scheme). DNS for both must point at the production Coolify server.
API_DOMAIN=api.selahcueapp.com
WEBSITE_DOMAIN=selahcueapp.com

# Use staging on a staging installation.
ENVIRONMENT=prod
SECRET_KEY=
SELAHCUE_ENTITLEMENT_SIGNING_KEY=

SQL_DATABASE=selahcue
SQL_USER=selahcue
SQL_PASSWORD=
REDIS_PASSWORD=

# SMTP with STARTTLS; the sender must be on the provider's verified domain.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@selahcueapp.com

# HSTS ramp-up. Raise SECURE_HSTS_SECONDS to 31536000 once HTTPS is verified on every in-scope
# host, and only then reconsider includeSubDomains/preload (docs/ops/DEPLOYMENT.md section 6c).
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
