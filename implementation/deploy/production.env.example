# SelahCue production environment for docker-compose.prod.yml on Coolify.
#
# Paste this into the resource's Environment Variables page (Developer view), then fill in the
# required values and the SMTP credentials needed by your provider. Lock SECRET_KEY,
# SELAHCUE_ENTITLEMENT_SIGNING_KEY, SQL_PASSWORD, REDIS_PASSWORD and MAIL_PASSWORD as secrets.
# Never commit a filled-in copy. For a local rehearsal, use the gitignored deploy/production.env
# path and pass it with --env-file.
#
# Compose sets the database and Redis hosts and URLs, proxy trust, DEBUG=0 and pilot flags off.
# See the repository-root DEPLOYMENT.md for optional inputs and the deployment sequence.
#
# Generate the Django and service passwords on a trusted machine with terminal logging off.
#   SECRET_KEY:                       python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
#   SQL_PASSWORD, REDIS_PASSWORD:     python3 -c 'import secrets; print(secrets.token_hex(32))'
# (hex for the two passwords: REDIS_PASSWORD is placed inside redis:// URLs unescaped.)
# For the existing desktop release trust, obtain the authorised matching seed for
# SELAHCUE_ENTITLEMENT_SIGNING_KEY from restricted storage. Verify its derived public key
# against the final packages and key ID e506b735. A freshly generated independent seed will
# not match. Follow the signing rotation procedure in DEPLOYMENT.md if the seed is unavailable.
# Keep both secrets stable across deploys with restricted backups outside Coolify. Rotating
# SECRET_KEY invalidates credential fingerprints. Entitlement verification depends on client trust.

# Public hostnames (no scheme). DNS for both must point at the production Coolify server.
API_DOMAIN=api.selahcueapp.com
WEBSITE_DOMAIN=selahcueapp.com

# Use staging on a staging installation.
ENVIRONMENT=prod
SECRET_KEY=
SELAHCUE_ENTITLEMENT_SIGNING_KEY=

SQL_DATABASE=selahcue
SQL_USER=selahcue
SQL_PASSWORD=
REDIS_PASSWORD=

# SMTP with STARTTLS; the sender must be on the provider's verified domain.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@selahcueapp.com

# HSTS ramp-up. Raise SECURE_HSTS_SECONDS to 31536000 once HTTPS is verified on every in-scope
# host, and only then reconsider includeSubDomains/preload (docs/ops/DEPLOYMENT.md section 6c).
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
