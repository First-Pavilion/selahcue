# SelahCue production environment for docker-compose.prod.yml.
#
#   cp deploy/production.env.example deploy/production.env && chmod 600 deploy/production.env
#
# deploy/production.env is gitignored. It is read twice: by Compose for ${...} interpolation
# (--env-file) and by every API-image container (env_file). Keep it on the server only, back it
# up to your secret store, and never bake it into an image.
#
# Full reference for every name: ../deployments.md section 1 and ../DEPLOYMENT.md "Runtime
# environment". The stack itself sets SQL_ENGINE, SQL_HOST, SQL_PORT, CACHE_URL,
# CELERY_BROKER_URL, CELERY_RESULT_BACKEND and SELAHCUE_TRUSTED_PROXY_COUNT; do not set them here.
#
# Generate the secrets on a trusted machine, in a terminal that is not logged:
#   SECRET_KEY:                       python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
#   SELAHCUE_ENTITLEMENT_SIGNING_KEY: python3 -c 'import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
#   SQL_PASSWORD, REDIS_PASSWORD:     python3 -c 'import secrets; print(secrets.token_hex(32))'
# (hex for the two passwords: REDIS_PASSWORD is placed inside redis:// URLs unescaped.)

# --- Release ------------------------------------------------------------------
# Image names/tag. Leave as-is to build on this host; point at a registry to pull instead.
RELEASE_TAG=latest
API_IMAGE=selahcue-api
WEBSITE_IMAGE=selahcue-website

# --- Edge (Caddy) ---------------------------------------------------------------
API_DOMAIN=api.selahcueapp.com
WEBSITE_DOMAIN=selahcueapp.com
# Let's Encrypt account / expiry notices.
ACME_EMAIL=

# --- Django core ----------------------------------------------------------------
ENVIRONMENT=prod
DEBUG=0
SECRET_KEY=
# Both public Host values, space-separated.
DJANGO_ALLOWED_HOSTS=api.selahcueapp.com selahcueapp.com
FRONTEND_BASE_URL=https://selahcueapp.com
# Caddy overwrites X-Forwarded-Proto on every route (deploy/Caddyfile), so this is safe here.
SELAHCUE_TRUST_FORWARDED_PROTO=1
# HSTS ramp-up (DEPLOYMENT.md section 6c): start short, without includeSubDomains/preload.
# Once HTTPS is verified on every in-scope host, raise to 31536000 and reconsider the other two.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# --- Entitlements -----------------------------------------------------------------
SELAHCUE_ENTITLEMENT_SIGNING_KEY=

# --- PostgreSQL (the `db` service is created with these) ---------------------------
SQL_DATABASE=selahcue
SQL_USER=selahcue
SQL_PASSWORD=

# --- Redis (the `redis` service requires this password) ----------------------------
REDIS_PASSWORD=

# --- Mail (worker only; STARTTLS on 587) --------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# A sender on your SMTP provider's verified domain.
DEFAULT_FROM_EMAIL=noreply@selahcueapp.com
# Optional contact address; unset uses the built-in default. Do not leave it set but empty.
# DEFAULT_EMAIL=

# --- Leave off for this release ------------------------------------------------------
SELAHCUE_PILOT_REGISTRATION_ENABLED=0
SELAHCUE_PILOT_GRANT_ENABLED=0
