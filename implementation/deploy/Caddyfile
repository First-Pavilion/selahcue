# TLS edge for docker-compose.prod.yml. Caddy obtains and renews certificates for both domains
# automatically (DNS must point at this host and ports 80/443 must be open), redirects HTTP to
# HTTPS, and is the ONE proxy hop in front of Django on every route.
#
# What this file guarantees, and the settings that depend on it:
#
# - X-Forwarded-For / X-Forwarded-Proto: no `trusted_proxies` is configured, so Caddy REPLACES
#   whatever the client sent with the real peer address and scheme. Django therefore sees exactly
#   one trustworthy hop: SELAHCUE_TRUSTED_PROXY_COUNT=1 and SELAHCUE_TRUST_FORWARDED_PROTO=1 are
#   safe (docs/ops/DEPLOYMENT.md sections 6b and 6c). If you put a CDN or load balancer in front
#   of Caddy, both settings change: re-read those sections first.
# - Browser traffic on the website domain goes to `api` DIRECTLY for /graphql/*, not through the
#   website's nginx, so browser and native routes have the same hop count. The website stays
#   same-origin with the API, which the SameSite=Strict session cookie and CSRF origin check need.
# - Inbound X-SelahCue-* identity headers are stripped (DEPLOYMENT.md section 6b).
# - /graphql/admin is not exposed: production staff authentication does not exist yet.
# - No access log is written (Caddy logs none unless a `log` directive is added). Request URLs
#   carry single-use tokens (/verify?token=...), so keep it that way or redact query strings.

{
	email {$ACME_EMAIL}
}

(selahcue_edge) {
	request_header -X-SelahCue-*
	header -Server

	@staff_graph path /graphql/admin /graphql/admin/*
	respond @staff_graph 404
}

{$API_DOMAIN} {
	import selahcue_edge
	reverse_proxy api:8000
}

{$WEBSITE_DOMAIN} {
	import selahcue_edge

	@api path /graphql/*
	reverse_proxy @api api:8000

	reverse_proxy website:80
}
