{
  "name": "marketing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\"",
    "sync:legal": "node scripts/sync_legal.ts",
    "check:legal": "node scripts/sync_legal.ts --check",
    "test:legal-pages": "npm run build && python3 scripts/legal_pages_headless.py",
    "test:mirrors": "python3 scripts/service_text_reference.py",
    "test:states": "npm run build && python3 scripts/auth_pages_headless.py"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
